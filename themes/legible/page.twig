{% set theme = settings.themes.legible %}
{% set published = metatabs.meta.manualdate ? metatabs.meta.manualdate : metatabs.meta.modified %}
{% set isFolder = item.elementType == 'folder' and item.folderContent|length > 0 %}

<div class="lg-container">

  <article class="lg-article lg-measure">

    {% if (theme.breadcrumb ?? true) %}
      {% include 'partials/breadcrumb.twig' %}
    {% endif %}

    <h1 class="lg-article__title">{{ title|e }}</h1>

    {% set showDate = 'top' in theme.datePosition|default([]) %}
    {% set showAuthor = 'top' in theme.authorPosition|default([]) %}
    {% if showDate or showAuthor %}
      <div class="lg-article__meta">
        {% if showAuthor %}
          <span>{{ metatabs.meta.author|default(settings.author)|e }}</span>
        {% endif %}
        {% if showDate and published %}
          <span><time datetime="{{ published }}">{{ published|date(theme.dateFormat|default('M j, Y')) }}</time></span>
        {% endif %}
      </div>
    {% endif %}

    <div class="lg-prose">{{ content }}</div>

  </article>

  {% if isFolder %}
    <section class="lg-section lg-measure" aria-labelledby="lg-contents-title">
      <h2 class="lg-section__title" id="lg-contents-title">
        {{ theme.contentsTitle|default(translate('In this section'))|e }}
      </h2>

      {% if item.contains == 'posts' %}
        {% set pagesize = theme.blogpagesize|default(10) %}
        {% set pagesize = pagesize > 0 ? pagesize : 10 %}
        {% set pages = (item.folderContent|length / pagesize)|round(0, 'ceil') %}
        {% set folderpage = currentpage and currentpage matches '/^[1-9][0-9]*$/' ? currentpage : 1 %}
        {% set folderpage = pages > 0 and folderpage > pages ? pages : folderpage %}

        {% include 'partials/pagelist.twig' with {
          entries: item.folderContent|slice((folderpage - 1) * pagesize, pagesize)
        } %}

        {% include 'partials/pagination.twig' with {
          page: folderpage,
          pages: pages,
          pagerbase: item.urlRel
        } %}
      {% else %}
        {% include 'partials/pagelist.twig' with { entries: item.folderContent } %}
      {% endif %}
    </section>
  {% endif %}

  {% if item.prevItem or item.nextItem %}
    <nav class="lg-pager lg-measure" aria-label="{{ theme.pagerLabel|default(translate('Previous and next page'))|e('html_attr') }}">
      {% if item.prevItem %}
        <a class="lg-pager__item" href="{{ item.prevItem.urlRel }}">
          <span class="lg-pager__label">{{ theme.previous|default(translate('Previous'))|e }}</span>
          <span class="lg-pager__title">{{ item.prevItem.name|e }}</span>
        </a>
      {% endif %}
      {% if item.nextItem %}
        <a class="lg-pager__item lg-pager__item--next" href="{{ item.nextItem.urlRel }}">
          <span class="lg-pager__label">{{ theme.next|default(translate('Next'))|e }}</span>
          <span class="lg-pager__title">{{ item.nextItem.name|e }}</span>
        </a>
      {% endif %}
    </nav>
  {% endif %}

</div>

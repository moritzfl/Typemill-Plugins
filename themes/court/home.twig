{% set theme = settings.themes.court %}
{% set heroTitle = theme.heroTitle|default('') ?: title %}
{% set heroImage = metatabs.meta.heroimage|default('') %}
{% set heroIsCrest = theme.heroImageStyle|default('auto') == 'crest' or (theme.heroImageStyle|default('auto') == 'auto' and heroImage|lower ends with '.svg') %}

<section class="ct-hero ct-hero--club">
  <div class="ct-container ct-hero__grid">
    <div class="ct-hero__copy">
      <p class="ct-hero__eyebrow">{{ (theme.heroEyebrow|default('') ?: translate('Welcome to the club'))|e }}</p>
      <h1 class="ct-hero__title">{{ heroTitle|e }}</h1>
      {% if theme.heroSubtitle or metatabs.meta.description %}
        <p class="ct-hero__subtitle">{{ (theme.heroSubtitle|default('') ?: metatabs.meta.description)|e }}</p>
      {% endif %}

      <div class="ct-hero__actions">
        {% if clubActionLabel and clubActionHref %}
          <a class="ct-btn" href="{{ clubActionHref|e('html_attr') }}">
            {{ clubActionLabel|e }}{% include 'partials/icon.twig' %}
          </a>
        {% endif %}
        {% if theme.heroLinkLabel and theme.heroLinkTarget %}
          {% set heroLinkHref = theme.heroLinkTarget starts with '/' ? base_url ~ theme.heroLinkTarget : theme.heroLinkTarget %}
          <a class="ct-hero__link" href="{{ heroLinkHref|e('html_attr') }}">{{ theme.heroLinkLabel|e }}{% include 'partials/icon.twig' with {iconDirection: 'right'} only %}</a>
        {% elseif theme.showTiles ?? true %}
          {% if navigation|length > 0 %}
            <a class="ct-hero__link" href="#club-sections">{{ translate('Discover the club')|e }}{% include 'partials/icon.twig' with {iconDirection: 'down'} only %}</a>
          {% endif %}
        {% endif %}
      </div>
    </div>

    <div class="ct-hero__visual{{ heroImage and not heroIsCrest ? ' ct-hero__visual--photo' : '' }}">
      {% if heroImage and not heroIsCrest %}
        <img class="ct-hero__photo" src="{{ base_url }}/{{ heroImage }}"
             alt="{{ metatabs.meta.heroimagealt|default('')|e('html_attr') }}"
             fetchpriority="high" />
      {% else %}
        {% include 'partials/court-art.twig' %}
        <div class="ct-hero__visual-top" aria-hidden="true"><span>{{ settings.title|e }}</span></div>
        <div class="ct-hero__visual-bottom">
          {% if heroImage %}
            <div class="ct-hero__crest">
              <img src="{{ base_url }}/{{ heroImage }}"
                   alt="{{ metatabs.meta.heroimagealt|default(settings.title)|e('html_attr') }}"
                   data-svg-invert="false" />
            </div>
          {% endif %}
          <p>{{ translate('Together on court.')|e }}</p>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% if (theme.showTiles ?? true) and navigation|length > 0 %}
  <section class="ct-shortcuts" id="club-sections" aria-labelledby="club-sections-title">
    <div class="ct-container">
      <div class="ct-section-heading">
        <h2 class="ct-kicker" id="club-sections-title">{{ (theme.tilesTitle|default('') ?: translate('Your club at a glance'))|e }}</h2>
        {% if theme.tilesLead %}<p class="ct-section__lead">{{ theme.tilesLead|e }}</p>{% endif %}
      </div>
      <ul class="ct-tiles">
        {% for element in navigation %}
          <li class="ct-tile">
            <span class="ct-tile__number" aria-hidden="true">{{ '%02d'|format(loop.index) }}</span>
            <h3 class="ct-tile__title"><a class="ct-tile__link" href="{{ element.urlRel }}">{{ element.name|e }}</a></h3>
            <span class="ct-tile__arrow" aria-hidden="true">{% include 'partials/icon.twig' %}</span>
          </li>
        {% endfor %}
      </ul>
    </div>
  </section>
{% endif %}

{% if content|trim %}
  <section class="ct-section ct-home-content">
    <div class="ct-container">
      <div class="ct-article"><div class="ct-prose">{{ content }}</div></div>
    </div>
  </section>
{% endif %}

{% if theme.showNews ?? true %}
  {# Use the published navigation and load metadata for only three posts. An
     absent/empty news folder produces no placeholder or broken link. #}
  {% set clubNews = getPageList(navigation, theme.blogfolder|default('/news')) %}
  {% if clubNews.contains|default('') == 'posts' and clubNews.folderContent|length > 0 %}
    <section class="ct-section ct-home-news" aria-labelledby="club-news-title">
      <div class="ct-container">
        <div class="ct-section-heading">
          <div>
            <p class="ct-kicker">{{ translate('Club life')|e }}</p>
            <h2 class="ct-section__title" id="club-news-title">{{ (theme.newsTitle|default('') ?: translate('From the club'))|e }}</h2>
          </div>
          <a class="ct-text-link" href="{{ clubNews.urlRel }}">{{ translate('All news')|e }}{% include 'partials/icon.twig' %}</a>
        </div>
        {% include 'partials/posts.twig' with {postitems: clubNews.folderContent|slice(0, 3), postHeading: 'h3'} %}
      </div>
    </section>
  {% endif %}
{% endif %}

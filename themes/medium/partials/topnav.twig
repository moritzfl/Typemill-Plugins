{#
  Global navigation. Deliberately quiet: a wordmark, a thin rule and small grey
  links, so the article carries the page.

  Sections that contain pages expand into a small panel anchored under the item.
  The panel is nested in its list item so the same markup can serve as an
  accordion in the mobile drawer.
#}
<header class="md-nav" data-nav>
  <div class="md-nav__inner">

    <a href="{{ base_url }}" class="md-nav__brand">
      {% if logo %}
        <img src="{{ base_url }}/{{ logo }}" alt="{{ settings.title|e('html_attr') }}" />
      {% else %}
        {{ settings.title|e }}
      {% endif %}
    </a>

    <nav aria-label="{{ settings.themes.medium.navLabel|default(translate('Main'))|e('html_attr') }}">
      <ul class="md-nav__links">
        {% for element in navigation %}
          {# A posts folder is one destination in the menu, not a menu of every
             article it holds. #}
          {% set children = element.elementType == 'folder' and element.contains|default('pages') != 'posts'
              ? element.folderContent : [] %}
          {% set panelId = 'md-sub-' ~ loop.index %}

          <li class="md-nav__item{{ children|length > 0 ? ' md-nav__item--has-menu' : '' }}"
              {% if children|length > 0 %}data-nav-item{% endif %}>

            <a href="{{ element.urlRel }}"
               class="md-nav__link"
               {% if element.active %}aria-current="page"{% endif %}
               {% if children|length > 0 %}
                 data-nav-parent
                 aria-expanded="false"
                 aria-controls="{{ panelId }}"
               {% endif %}>{{ element.name|e }}</a>

            {% if children|length > 0 %}
              <div class="md-dropdown" id="{{ panelId }}" data-nav-panel>
                <ul class="md-dropdown__list">
                  {% for child in children %}
                    <li>
                      <a href="{{ child.urlRel }}"{% if child.active %} aria-current="page"{% endif %}>{{ child.name|e }}</a>
                    </li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}
          </li>
        {% endfor %}

        {% if multilang is defined and multilang %}
          {% for lang, link in multilang %}
            <li class="md-nav__item"><a class="md-nav__link" href="{{ base_url }}{{ link }}">{{ lang|upper }}</a></li>
          {% endfor %}
        {% endif %}
      </ul>
    </nav>

    <button type="button"
            class="md-nav__toggle"
            data-nav-toggle
            aria-expanded="false"
            aria-label="{{ settings.themes.medium.menuLabel|default(translate('Menu'))|e('html_attr') }}">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path stroke-linecap="round" d="M3 6h18M3 12h18M3 18h18" />
      </svg>
    </button>

  </div>
</header>

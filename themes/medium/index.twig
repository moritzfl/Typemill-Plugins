{% extends 'layout.twig' %}

{% block title %}{{ metatabs.meta.title|e }} | {{ settings.title|e }}{% endblock %}

{% block content %}

  {% set homepage = item.urlRel == '/' %}

  {% if homepage and settings.themes.medium.blog %}
    {% include 'blog.twig' %}
  {% elseif homepage %}
    {% include 'home.twig' %}
  {% else %}
    {% include 'page.twig' %}
  {% endif %}

{% endblock %}

{% set theme = settings.themes.medium %}
{% set mastheadTitle = theme.mastheadTitle|default('') ?: title %}

<section class="md-masthead">
  <div class="md-container">
    <h1 class="md-masthead__title">{{ mastheadTitle|e }}</h1>

    {% if theme.mastheadTagline %}
      <p class="md-masthead__tagline">{{ theme.mastheadTagline|e }}</p>
    {% elseif metatabs.meta.description %}
      <p class="md-masthead__tagline">{{ metatabs.meta.description|e }}</p>
    {% endif %}

    {% if theme.mastheadBtnLabel and theme.mastheadBtnLink %}
      <div class="md-masthead__actions">
        <a class="md-btn" href="{{ theme.mastheadBtnLink|e }}">{{ theme.mastheadBtnLabel|e }}</a>
      </div>
    {% endif %}
  </div>
</section>

<div class="md-container">

  {% if content|trim %}
    <div class="md-article" style="padding-block:48px 24px">
      <div class="md-prose">{{ content }}</div>
    </div>
  {% endif %}

  {# The homepage lists the sections as a feed, in the same shape as posts. #}
  {% if (theme.showSections ?? true) and navigation|length > 0 %}
    {% if theme.sectionsLabel %}
      <p class="md-section-label">{{ theme.sectionsLabel|e }}</p>
    {% endif %}

    <ul class="md-feed">
      {% for element in navigation %}
        <li class="md-post">
          <div class="md-post__body">
            {% if element.elementType == 'folder' and element.folderContent|length > 0 %}
              <p class="md-post__meta">
                <span>{{ element.folderContent|length }} {{ theme.sectionCountLabel|default('stories')|e }}</span>
              </p>
            {% endif %}
            <h2 class="md-post__title"><a href="{{ element.urlRel }}">{{ element.name|e }}</a></h2>
          </div>
        </li>
      {% endfor %}
    </ul>
  {% endif %}

</div>

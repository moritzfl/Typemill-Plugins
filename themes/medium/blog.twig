{% set theme = settings.themes.medium %}

<section class="md-masthead">
  <div class="md-container">
    <h1 class="md-masthead__title">{{ theme.mastheadTitle|default('') ?: title|e }}</h1>
    {% if theme.mastheadTagline %}
      <p class="md-masthead__tagline">{{ theme.mastheadTagline|e }}</p>
    {% elseif metatabs.meta.description %}
      <p class="md-masthead__tagline">{{ metatabs.meta.description|e }}</p>
    {% endif %}
  </div>
</section>

<div class="md-container">

  {% if theme.blogintro and content|trim %}
    <div class="md-article" style="padding-block:48px 16px">
      <div class="md-prose">{{ content }}</div>
    </div>
  {% endif %}

  {% set pagelist = getPageList(navigation, theme.blogfolder, base_url) %}
  {# Twig only substitutes a default for an empty value, and zero is not empty,
     so a page size of zero would reach the division below. #}
  {% set pagesize = theme.blogpagesize|default(10) %}
  {% set pagesize = pagesize > 0 ? pagesize : 10 %}
  {% set pages = (pagelist.folderContent|length / pagesize)|round(0, 'ceil') %}
  {# Core accepts any numeric last segment, so /p/02 and /p/2.5 arrive here too;
     a float would slice at a fractional offset. #}
  {% set blogpage = currentpage and currentpage matches '/^[1-9][0-9]*$/' ? currentpage : 1 %}
  {% set blogpage = pages > 0 and blogpage > pages ? pages : blogpage %}
  {% set offset = (blogpage - 1) * pagesize %}
  {# The homepage is '/', and '/' ~ '/p/2' is '//p/2' - which a browser reads as
     a host, not as a path, and follows off the site. #}
  {% set pagerbase = item.urlRel == '/' ? base_url : item.urlRel %}

  {% if pagelist.contains == 'posts' %}

    {% include 'partials/posts.twig' with {
      postitems: pagelist.folderContent|slice(offset, pagesize)
    } %}

    {% include 'partials/pagination.twig' with {
      page: blogpage,
      pages: pages,
      pagerbase: pagerbase
    } %}

  {% else %}
    <div class="md-article">
      <p class="md-post__excerpt">
        {{ theme.blogEmptyText|default(translate('The configured folder does not contain posts. Check the blog folder in the theme settings.'))|e }}
      </p>
    </div>
  {% endif %}

</div>

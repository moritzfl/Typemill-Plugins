{# Horizontal top navigation (desktop only) — used when theme.navposition == 'top'.
   Small screens keep the drawer from partials/navigation.twig. #}
<nav aria-label="Site navigation" class="hidden min-w-0 flex-1 items-center justify-end gap-1 lg:flex">

  {# ponytail: no overflow handling — sites with too many top-level pages should use sidebar mode #}
  <ul class="flex min-w-0 items-center gap-1">
    {% for element in navigation %}
      {% set hasChildren = element.elementType == 'folder' and element.folderContent|length > 0 and element.contains == 'pages' %}
      <li class="group relative shrink-0">
        <a href="{{ element.urlRel }}"
           class="flex items-center gap-1 rounded-full px-3 py-1.5 text-sm transition-colors
             {%- if element.active %} bg-primary-100/85 dark:bg-primary-900/40 text-primary-700 dark:text-primary-300 font-medium
             {%- elseif element.activeParent %} text-gray-900 dark:text-white font-semibold
             {%- else %} text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 hover:bg-gray-100/80 dark:hover:bg-gray-900/80
             {%- endif %}">
          <span class="whitespace-nowrap">{% if settings.themes.rueckenwind.chapnum and element.chapter %}{{ element.chapter|e }}&nbsp;{% endif %}{{ element.name|e }}</span>
          {%- if hasChildren -%}
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
            </svg>
          {%- endif -%}
        </a>

        {%- if hasChildren -%}
          {# Dropdown: first-level children, opens on hover/keyboard focus #}
          <ul class="invisible absolute right-0 top-full z-50 min-w-48 rounded-xl border border-gray-200/80 bg-white/95 p-1.5 opacity-0 shadow-lg shadow-gray-950/10 backdrop-blur-xl transition-opacity group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 dark:border-gray-800 dark:bg-gray-950/95">
            {% for child in element.folderContent %}
              <li>
                <a href="{{ child.urlRel }}"
                   class="block truncate rounded-lg px-3 py-2 text-sm transition-colors
                     {%- if child.active %} bg-primary-100/85 dark:bg-primary-900/40 text-primary-700 dark:text-primary-300 font-medium
                     {%- else %} text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 hover:bg-gray-100/80 dark:hover:bg-gray-900/80
                     {%- endif %}">
                  {% if settings.themes.rueckenwind.chapnum and child.chapter %}{{ child.chapter|e }}&nbsp;{% endif %}{{ child.name|e }}
                </a>
              </li>
            {% endfor %}
          </ul>
        {%- endif -%}
      </li>
    {% endfor %}
  </ul>

  {% if multilang is defined and multilang %}
    <div class="ml-2 flex shrink-0 items-center gap-1.5 border-l border-gray-200/80 pl-3 dark:border-gray-700/80">
      {% for lang, link in multilang %}
        <a href="{{ base_url }}{{ link }}" class="rounded-full border border-gray-200 bg-white/80 px-2.5 py-1 text-xs font-medium text-gray-600 shadow-sm shadow-gray-950/5 transition-colors hover:border-primary-300 hover:text-primary-700 dark:border-gray-700 dark:bg-gray-900/70 dark:text-gray-300 dark:hover:border-primary-700 dark:hover:text-primary-200">{{ lang }}</a>
      {% endfor %}
    </div>
  {% endif %}

  <div class="ml-2 shrink-0 scale-90">
    {% include 'partials/colormode.twig' %}
  </div>

</nav>

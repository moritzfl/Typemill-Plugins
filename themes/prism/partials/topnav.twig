{#
  Global navigation.

  Over a coloured hero the bar sits on top of it with transparent background and
  white text; everywhere else it is solid with a hairline border. Templates that
  open with a hero pass overlay: true.

  Sections that contain pages expand into a floating card anchored under the
  item. The panel is nested in its list item so the same markup can serve as an
  accordion in the mobile drawer.
#}
{% set overlay = overlay|default(home|default(false)) %}

<header class="pr-nav{{ overlay ? ' pr-nav--overlay' : '' }}" data-nav>
  <div class="pr-nav__inner">

    <a href="{{ base_url }}" class="pr-nav__brand">
      {% if logo %}
        <img src="{{ base_url }}/{{ logo }}" alt="{{ settings.title|e('html_attr') }}" />
      {% else %}
        {{ settings.title|e }}
      {% endif %}
    </a>

    <nav aria-label="{{ settings.themes.prism.navLabel|default('Main')|e('html_attr') }}">
      <ul class="pr-nav__links">
        {% for element in navigation %}
          {% set children = element.elementType == 'folder' ? element.folderContent : [] %}
          {% set panelId = 'pr-sub-' ~ loop.index %}

          <li class="pr-nav__item{{ children|length > 0 ? ' pr-nav__item--has-menu' : '' }}"
              {% if children|length > 0 %}data-nav-item{% endif %}>

            <a href="{{ element.urlRel }}"
               class="pr-nav__link"
               {% if element.active %}aria-current="page"{% endif %}
               {% if children|length > 0 %}
                 data-nav-parent
                 aria-haspopup="true"
                 aria-expanded="false"
                 aria-controls="{{ panelId }}"
               {% endif %}>{{ element.name|e }}</a>

            {% if children|length > 0 %}
              <div class="pr-dropdown" id="{{ panelId }}" data-nav-panel>
                <ul class="pr-dropdown__list">
                  {% for child in children %}
                    <li>
                      <a href="{{ child.urlRel }}"{% if child.active %} aria-current="page"{% endif %}>
                        <span class="pr-dropdown__name">{{ child.name|e }}</span>
                      </a>
                    </li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}
          </li>
        {% endfor %}

        {% if multilang is defined and multilang %}
          {% for lang, link in multilang %}
            <li class="pr-nav__item"><a class="pr-nav__link" href="{{ base_url }}{{ link }}">{{ lang|upper }}</a></li>
          {% endfor %}
        {% endif %}
      </ul>
    </nav>

    <button type="button"
            class="pr-nav__toggle"
            data-nav-toggle
            aria-expanded="false"
            aria-label="{{ settings.themes.prism.menuLabel|default('Menu')|e('html_attr') }}">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" d="M3 6h18M3 12h18M3 18h18" />
      </svg>
    </button>

  </div>
</header>

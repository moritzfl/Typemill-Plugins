{% set theme = settings.themes.prism %}
{# Only the absence of the variable falls back to the page's own children: an
   explicitly empty slice must stay empty. #}
{% set postitems = postitems is defined ? postitems : item.folderContent|default([]) %}

{% if postitems|length > 0 %}
  <ul class="pr-grid">
    {% for element in postitems %}
      {% set post = getPageMeta(settings, element) %}
      {% set orderDate = element.order is defined and element.order matches '/^\\d{8}$/'
          ? element.order[0:4] ~ '-' ~ element.order[4:2] ~ '-' ~ element.order[6:2] : '' %}
      {% set date = post.meta.manualdate|default(post.meta.modified|default(orderDate)) %}

      <li class="pr-card">
        {% if (theme.blogimage ?? true) and post.meta.heroimage %}
          <a class="pr-post__media" href="{{ element.urlRel }}" tabindex="-1" aria-hidden="true">
            <img src="{{ assets.image(post.meta.heroimage).resize(820, 462).src() }}"
                 alt="{{ post.meta.heroimagealt|default('')|e('html_attr') }}"
                 loading="lazy" decoding="async" />
          </a>
        {% endif %}

        {% if date %}
          <p class="pr-post__date"><time datetime="{{ date }}">{{ date|date(theme.dateFormat|default('d.m.Y')) }}</time></p>
        {% endif %}

        <h3 class="pr-card__title">
          <a href="{{ element.urlRel }}">{{ post.meta.title|default(element.name)|e }}</a>
        </h3>

        {% if post.meta.description %}
          <p class="pr-card__text">{{ post.meta.description|e }}</p>
        {% endif %}

        <div><a class="pr-link" href="{{ element.urlRel }}">{{ translate('Read more') }}</a></div>
      </li>
    {% endfor %}
  </ul>
{% endif %}

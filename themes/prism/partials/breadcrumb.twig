<nav class="pr-breadcrumb" aria-label="Breadcrumb">
  <a href="{{ base_url }}">{{ settings.themes.prism.homeLabel|default(translate('Home'))|e }}</a>
  {% for crumb in breadcrumb %}
    <span aria-hidden="true">/</span>
    {% if loop.last %}
      <span aria-current="page">{{ crumb.name|e }}</span>
    {% else %}
      <a href="{{ crumb.urlRel }}">{{ crumb.name|e }}</a>
    {% endif %}
  {% endfor %}
</nav>

{% extends 'layout.twig' %}

{% block title %}{{ metatabs.meta.title|e }} | {{ settings.title|e }}{% endblock %}

{# The bar floats over a full-bleed picture, and sits on the surface without one. #}
{% block nav %}
  {% set atelier = settings.themes.atelier %}

  {#
    The journal homepage opens with a plain hero whatever pictures the entries
    carry, so it must not ask for the floating bar: pale type over a pale
    surface, with nothing behind it to read against.
  #}
  {% set hasHero = home and atelier.blog
      ? ''
      : (home
          ? (atelier.heroImage|default('') ?: metatabs.meta.heroimage|default(''))
          : ((atelier.pageHero ?? true) ? metatabs.meta.heroimage|default('') : '')) %}

  {% include 'partials/topnav.twig' with { overlay: hasHero ? true : false } %}
{% endblock %}

{% block content %}

  {% if home and settings.themes.atelier.blog %}
    {% include 'blog.twig' %}
  {% elseif home %}
    {% include 'home.twig' %}
  {% else %}
    {% include 'page.twig' %}
  {% endif %}

{% endblock %}

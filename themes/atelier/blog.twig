{% set theme = settings.themes.atelier %}

<section class="at-hero at-hero--plain">
  <div class="at-hero__inner">
    {% if theme.heroEyebrow %}
      <p class="at-hero__eyebrow">{{ theme.heroEyebrow|e }}</p>
    {% endif %}
    <h1 class="at-hero__title">{{ (theme.heroTitle|default('') ?: title)|e }}</h1>
    {% if theme.heroCaption %}
      <p class="at-hero__caption">{{ theme.heroCaption|e }}</p>
    {% endif %}
  </div>
</section>

<div class="at-container">

  {% if theme.blogintro and content|trim %}
    <div class="at-article" style="padding-block:40px 8px">
      <div class="at-prose">{{ content }}</div>
    </div>
  {% endif %}

  {% set pagelist = getPageList(navigation, theme.blogfolder, base_url) %}
  {# Twig only substitutes a default for an empty value, and zero is not empty,
     so a page size of zero would reach the division below. #}
  {% set pagesize = theme.blogpagesize|default(12) %}
  {% set pagesize = pagesize > 0 ? pagesize : 12 %}

  {# The wall only shows entries that carry a picture, so those are what a page
     is counted and cut from. Paginating the whole folder first left pages half
     empty, or empty altogether, whenever a stretch of entries had no image.

     default([]) because a folder that is not in the navigation - mistyped, or
     hidden - has no content at all, and filtering null is an error. #}
  {% set entries = pagelist.folderContent|default([])|filter(element => getPageMeta(settings, element).meta.heroimage) %}

  {% set pages = (entries|length / pagesize)|round(0, 'ceil') %}
  {# Core accepts any numeric last segment, so /p/02 and /p/2.5 arrive here too;
     a float would slice at a fractional offset. #}
  {% set blogpage = currentpage and currentpage matches '/^[1-9][0-9]*$/' ? currentpage : 1 %}
  {% set blogpage = pages > 0 and blogpage > pages ? pages : blogpage %}
  {% set offset = (blogpage - 1) * pagesize %}
  {# The homepage is '/', and '/' ~ '/p/2' is '//p/2' - which a browser reads as
     a host, not as a path, and follows off the site. #}
  {% set pagerbase = item.urlRel == '/' ? base_url : item.urlRel %}

  <section class="at-section">
    {% if pagelist.contains == 'posts' %}

      {% include 'partials/gallery.twig' with {
        entries: entries|slice(offset, pagesize)
      } %}

      {% include 'partials/pagination.twig' with {
        page: blogpage,
        pages: pages,
        pagerbase: pagerbase
      } %}

    {% else %}
      <p class="at-label">
        {{ theme.blogEmptyText|default(translate('The configured folder does not contain posts. Check the folder in the theme settings.'))|e }}
      </p>
    {% endif %}
  </section>

</div>

{% set theme = settings.themes.lucid %}
{% set heroTitle = theme.heroTitle|default('') ?: title %}
{% set heroImage = metatabs.meta.heroimage|default('') %}

{#
  The homepage is a stack of full-bleed sections rather than one column, so
  the hero, the page body and the section tiles each get their own band and the
  background alternates between them.
#}
<section class="lc-hero">
  <div class="lc-container">
    {% if theme.heroEyebrow %}
      <p class="lc-hero__eyebrow">{{ theme.heroEyebrow|e }}</p>
    {% endif %}

    <h1 class="lc-hero__title">{{ heroTitle|e }}</h1>

    {% if theme.heroSubtitle %}
      <p class="lc-hero__subtitle">{{ theme.heroSubtitle|e }}</p>
    {% endif %}

    {% if theme.heroBtnLabel and theme.heroBtnLink %}
      <div class="lc-hero__actions">
        <a class="lc-btn" href="{{ theme.heroBtnLink }}">{{ theme.heroBtnLabel|e }}</a>
        {% if theme.heroLinkLabel and theme.heroLinkTarget %}
          <a class="lc-link" href="{{ theme.heroLinkTarget }}">{{ theme.heroLinkLabel|e }}</a>
        {% endif %}
      </div>
    {% endif %}

    {% if heroImage %}
      <div class="lc-hero__media">
        <img src="{{ base_url }}/{{ heroImage }}"
             alt="{{ metatabs.meta.heroimagealt|default(heroTitle)|e('html_attr') }}" />
      </div>
    {% endif %}
  </div>
</section>

{% if content|trim %}
  <section class="lc-section lc-section--alt">
    <div class="lc-container">
      <div class="lc-article">
        <div class="lc-prose">{{ content }}</div>
      </div>
    </div>
  </section>
{% endif %}

{% if (theme.showTiles ?? true) and navigation|length > 0 %}
  <section class="lc-section">
    <div class="lc-container">
      {% if theme.tilesTitle %}
        <h2 class="lc-section__title">{{ theme.tilesTitle|e }}</h2>
      {% endif %}
      {% if theme.tilesLead %}
        <p class="lc-section__lead">{{ theme.tilesLead|e }}</p>
      {% endif %}

      <ul class="lc-tiles">
        {% for element in navigation %}
          <li class="lc-tile">
            <h3 class="lc-tile__title">{{ element.name|e }}</h3>
            <p class="lc-tile__text">
              {% if element.elementType == 'folder' and element.folderContent|length > 0 %}
                {{ element.folderContent|length }} {{ theme.tilesCountLabel|default('pages')|e }}
              {% endif %}
            </p>
            <div>
              <a class="lc-link" href="{{ element.urlRel }}">{{ theme.tilesLinkLabel|default('Learn more')|e }}</a>
            </div>
          </li>
        {% endfor %}
      </ul>
    </div>
  </section>
{% endif %}

{% set theme = settings.themes.lucid %}
{% set heroTitle = theme.heroTitle|default('') ?: title %}
{% set heroImage = metatabs.meta.heroimage|default('') %}

{#
  The homepage is a stack of full-bleed sections rather than one column, so
  the hero, the page body and the section tiles each get their own band and the
  background alternates between them.
#}
<section class="lc-hero">
  <div class="lc-container">
    {% if theme.heroEyebrow %}
      <p class="lc-hero__eyebrow">{{ theme.heroEyebrow|e }}</p>
    {% endif %}

    <h1 class="lc-hero__title">{{ heroTitle|e }}</h1>

    {% if theme.heroSubtitle %}
      <p class="lc-hero__subtitle">{{ theme.heroSubtitle|e }}</p>
    {% endif %}

    {% if theme.heroBtnLabel and theme.heroBtnLink %}
      <div class="lc-hero__actions">
        <a class="lc-btn" href="{{ theme.heroBtnLink|e }}">{{ theme.heroBtnLabel|e }}</a>
        {% if theme.heroLinkLabel and theme.heroLinkTarget %}
          <a class="lc-link" href="{{ theme.heroLinkTarget|e }}">{{ theme.heroLinkLabel|e }}</a>
        {% endif %}
      </div>
    {% endif %}

    {% if heroImage %}
      <div class="lc-hero__media">
        <img src="{{ base_url }}/{{ heroImage }}"
             alt="{{ metatabs.meta.heroimagealt|default(heroTitle)|e('html_attr') }}" />
      </div>
    {% endif %}
  </div>
</section>

{% if content|trim %}
  <section class="lc-section lc-section--alt">
    <div class="lc-container">
      <div class="lc-article">
        <div class="lc-prose">{{ content }}</div>
      </div>
    </div>
  </section>
{% endif %}

{% if (theme.showTiles ?? true) and navigation|length > 0 %}
  <section class="lc-section">
    <div class="lc-container">
      {% if theme.tilesTitle %}
        <h2 class="lc-section__title">{{ theme.tilesTitle|e }}</h2>
      {% endif %}
      {% if theme.tilesLead %}
        <p class="lc-section__lead">{{ theme.tilesLead|e }}</p>
      {% endif %}

      <ul class="lc-tiles">
        {% for element in navigation %}
          {#
            The summary is the page's own description when it has one, and the
            number of pages for a folder otherwise. Rendering the paragraph
            regardless left an empty line stretched by `flex`, which is what
            hollowed out a tile for a page that is simply a page.
          #}
          {% set meta = getPageMeta(settings, element).meta|default({}) %}
          {% set summary = meta.description|default('') ?: (
              element.elementType == 'folder' and element.folderContent|length > 0
                ? element.folderContent|length ~ ' ' ~ theme.tilesCountLabel|default(translate('pages'))
                : '') %}

          {#
            The link sits on the title and covers the whole tile. The title is
            what the destination is called, so that is what a screen reader
            reads out; a card full of links named "Open" tells a reader
            nothing. The label below repeats it for the eye only.
          #}
          <li class="lc-tile">
            <h3 class="lc-tile__title">
              <a class="lc-tile__link" href="{{ element.urlRel }}">{{ element.name|e }}</a>
            </h3>
            {% if summary %}
              <p class="lc-tile__text">{{ summary|e }}</p>
            {% endif %}
            <div class="lc-tile__action" aria-hidden="true">
              <span class="lc-link">{{ theme.tilesLinkLabel|default(translate('Open'))|e }}</span>
            </div>
          </li>
        {% endfor %}
      </ul>
    </div>
  </section>
{% endif %}

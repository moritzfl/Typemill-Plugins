{#
  Global navigation.

  Top-level sections that contain pages expand into a full-width panel below the
  bar. The panel markup is nested inside its list item so the same structure can
  serve as an accordion in the mobile drawer; on desktop it is positioned
  against the header, which spans the full width.
#}
<header class="lc-nav" data-nav>
  <div class="lc-nav__inner">

    <a href="{{ base_url }}" class="lc-nav__brand">
      {% if logo %}
        <img src="{{ base_url }}/{{ logo }}" alt="{{ settings.title|e('html_attr') }}" />
      {% else %}
        {{ settings.title|e }}
      {% endif %}
    </a>

    <nav aria-label="{{ settings.themes.lucid.navLabel|default(translate('Main'))|e('html_attr') }}">
      <ul class="lc-nav__links">
        {% for element in navigation %}
          {% set children = element.elementType == 'folder' ? element.folderContent : [] %}
          {% set panelId = 'lc-sub-' ~ loop.index %}

          <li class="lc-nav__item{{ children|length > 0 ? ' lc-nav__item--has-menu' : '' }}"
              {% if children|length > 0 %}data-nav-item{% endif %}>

            <a href="{{ element.urlRel }}"
               class="lc-nav__link"
               {% if element.active %}aria-current="page"{% endif %}
               {% if children|length > 0 %}
                 data-nav-parent
                 aria-expanded="false"
                 aria-controls="{{ panelId }}"
               {% endif %}>{{ element.name|e }}{% if children|length > 0 %}
              <svg class="lc-nav__caret" width="10" height="6" viewBox="0 0 10 6" fill="none"
                   stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M1 1l4 4 4-4" />
              </svg>
            {% endif %}</a>

            {% if children|length > 0 %}
              <div class="lc-mega" id="{{ panelId }}" data-nav-panel>
                <div class="lc-mega__inner">
                  <p class="lc-mega__eyebrow">{{ element.name|e }}</p>
                  <ul class="lc-mega__list">
                    {% for child in children %}
                      <li>
                        <a href="{{ child.urlRel }}"{% if child.active %} aria-current="page"{% endif %}>
                          {{ child.name|e }}
                        </a>
                      </li>
                    {% endfor %}
                  </ul>
                </div>
              </div>
            {% endif %}
          </li>
        {% endfor %}

        {% if multilang is defined and multilang %}
          {% for lang, link in multilang %}
            <li class="lc-nav__item"><a class="lc-nav__link" href="{{ base_url }}{{ link }}">{{ lang|upper }}</a></li>
          {% endfor %}
        {% endif %}
      </ul>
    </nav>

    <button type="button"
            class="lc-nav__toggle"
            data-nav-toggle
            aria-expanded="false"
            aria-label="{{ settings.themes.lucid.menuLabel|default(translate('Menu'))|e('html_attr') }}">
      <span class="lc-burger" aria-hidden="true"><span></span><span></span></span>
    </button>

  </div>
</header>

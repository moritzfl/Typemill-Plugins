{% set theme = settings.themes.lucid %}
<!DOCTYPE html>
<html lang="{{ settings.langattr | default('en') }}">
<head>
  <meta charset="UTF-8">
  <title>{% block title %}{% endblock %}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="color-scheme" content="light dark" />
  <meta name="description" content="{{ metatabs.meta.description|e('html_attr') }}" />
  <meta name="author" content="{{ metatabs.meta.author|default(settings.author)|e('html_attr') }}" />
  <meta name="generator" content="TYPEMILL" />
  <link rel="canonical" href="{{ item.urlAbs }}" />

  {{ assets.renderMeta() }}

  {% block stylesheets %}
  <link rel="stylesheet" href="{{ base_url }}/themes/lucid/css/lucid.css" />
  <style>
    {% if theme.accentColor %}
    :root { --lc-accent: {{ theme.accentColor }}; --lc-accent-hover: {{ theme.accentColor }}; }
    {% endif %}
    {% if theme.maxwidth %}
    :root { --lc-container: {{ theme.maxwidth }}; }
    {% endif %}
    {% if theme.customcss %}
    {{ theme.customcss }}
    {% endif %}
  </style>
  {% endblock %}
</head>
<body>

  <a href="#main-content" class="lc-skip">{{ theme.skipText|default('Skip to content') }}</a>

  {% if is_loggedin() %}
    <div class="lc-admin"><a href="{{ base_url }}/tm/account">&#9881; Admin</a></div>
  {% endif %}

  {% include 'partials/topnav.twig' %}

  <main id="main-content">
    {% block content %}{% endblock %}
  </main>

  {% include 'partials/footer.twig' %}

  {% block javascripts %}
  {{ assets.renderCSS() }}
  {{ assets.renderJS() }}
  <script>
    (function () {
      var nav = document.querySelector('[data-nav]');
      if (!nav) return;

      var toggle = nav.querySelector('[data-nav-toggle]');
      var items = Array.prototype.slice.call(nav.querySelectorAll('[data-nav-item]'));
      var hoverCapable = window.matchMedia('(hover: hover)');
      var wide = window.matchMedia('(min-width: 834px)');

      function setItemOpen(item, open) {
        item.classList.toggle('is-open', open);
        var link = item.querySelector('[data-nav-parent]');
        if (link) link.setAttribute('aria-expanded', open ? 'true' : 'false');
      }

      function closeAll(except) {
        items.forEach(function (item) {
          if (item !== except) setItemOpen(item, false);
        });
      }

      function setDrawer(open) {
        nav.classList.toggle('lc-nav--open', open);
        if (toggle) toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        document.body.style.overflow = open ? 'hidden' : '';
        if (!open) closeAll();
      }

      if (toggle) {
        toggle.addEventListener('click', function () {
          setDrawer(!nav.classList.contains('lc-nav--open'));
        });
      }

      items.forEach(function (item) {
        var link = item.querySelector('[data-nav-parent]');
        if (!link) return;

        // On a pointer device the panel follows the cursor. The panel is a
        // descendant of the item, so hovering it does not count as leaving.
        item.addEventListener('mouseenter', function () {
          if (wide.matches && hoverCapable.matches) {
            closeAll(item);
            setItemOpen(item, true);
          }
        });

        item.addEventListener('mouseleave', function () {
          if (wide.matches && hoverCapable.matches) {
            setItemOpen(item, false);
          }
        });

        link.addEventListener('click', function (e) {
          var drawerOpen = nav.classList.contains('lc-nav--open');
          var touchLike = e.pointerType === 'touch' || !hoverCapable.matches;

          // Mouse users already saw the panel on hover, so a click navigates.
          if (!drawerOpen && !touchLike) {
            return;
          }

          // Everywhere else the first tap reveals the section and the second
          // one follows the link.
          if (item.classList.contains('is-open')) {
            return;
          }

          e.preventDefault();
          closeAll(item);
          setItemOpen(item, true);
        });

        // Keyboard users reach the panel by tabbing into the section.
        link.addEventListener('focus', function () {
          if (wide.matches && hoverCapable.matches) {
            closeAll(item);
            setItemOpen(item, true);
          }
        });
      });

      nav.addEventListener('focusout', function (e) {
        if (wide.matches && !nav.contains(e.relatedTarget)) {
          closeAll();
        }
      });

      document.addEventListener('click', function (e) {
        if (!nav.contains(e.target)) {
          closeAll();
        }
      });

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
          closeAll();
          setDrawer(false);
        }
      });

      // Leaving the mobile breakpoint must not strand the drawer open.
      var onChange = function () {
        if (wide.matches) {
          setDrawer(false);
          closeAll();
        }
      };
      wide.addEventListener ? wide.addEventListener('change', onChange) : wide.addListener(onChange);
    })();
  </script>
  {% endblock %}

</body>
</html>
